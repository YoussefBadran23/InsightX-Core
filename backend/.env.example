
# ── App Settings ─────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Security Keys ──────────────────────────────────────────────
# Generate strong secrets: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_strong_secret_key_here_32_chars_min
ADMIN_SECRET_KEY=your_strong_admin_secret_key_here_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://insightx_user:insightx_pass@db:5432/insightx_db
MONGO_URL=mongodb://insightx_user:insightx_pass@localhost:27017/insightx_scraped

# ── Redis / Celery ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── AWS S3 ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=insightx-raw-data-lake-dev

# ── Local LLM (Ollama) ────────────────────────────
LOCAL_LLM_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen2.5-coder:7b

# ── Frontend & Uploads ────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_SIZE_MB=100

# ── SMTP Email ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_NAME=InsightX
EMAILS_FROM_EMAIL=noreply@insightx.local

# ── MongoDB Atlas ────────────────────────────────────────────
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/insightx_scraped

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
DD_API_KEY=your-datadog-api-key
DD_SERVICE=insightx-backend
DD_ENV=development
