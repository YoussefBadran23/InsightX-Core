
# ── App Settings ─────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Security Keys ──────────────────────────────────────────────
# Generate strong secrets: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_strong_secret_key_here_32_chars_min
ADMIN_SECRET_KEY=your_strong_admin_secret_key_here_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# ── Database (PostgreSQL only — MongoDB removed) ──────────────
DATABASE_URL=postgresql://insightx_user:insightx_pass@db:5432/insightx_db

# ── Redis / Celery ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Frontend & Uploads ────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_SIZE_MB=100

# ── SMTP Email ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_NAME=InsightX
EMAILS_FROM_EMAIL=noreply@insightx.local
# Brand-consistent From: address on password reset emails. Must be a verified
# sender in your SMTP provider. Defaults to support@insightx.io.
SUPPORT_EMAIL=support@insightx.io

# ── Gemini AI (Phase 4 — LLM insight enrichment) ────────────
# Get your free key at https://aistudio.google.com/apikey
# Free tier: 1,500 requests/day. Leave blank to disable LLM enrichment.
GOOGLE_AI_API_KEY=

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
DD_API_KEY=your-datadog-api-key
DD_SERVICE=insightx-backend
DD_ENV=development
