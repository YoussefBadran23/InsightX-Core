# Environment — copy to .env.local and fill in values

# The base URL of the FastAPI backend service
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public support email shown on the /support page and in mailto: links.
# Falls back to support@insightx.io if not set.
NEXT_PUBLIC_SUPPORT_EMAIL=support@insightx.io

# Sentry for error tracking
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
