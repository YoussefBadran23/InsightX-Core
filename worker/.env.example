# ==============================================================
# InsightX — Worker (Celery) Environment
# ==============================================================
# Copy this file to .env, then adjust if needed:
#     cp worker/.env.example worker/.env
#
# NOTE: Under docker-compose these values are OVERRIDDEN with the
# Docker service hostnames (db, redis), so the copy can stay as-is
# for Docker. You only need to edit them for running the worker
# locally WITHOUT Docker (the worker reads from the shell env).
# ==============================================================

PYTHONUNBUFFERED=1

# ---- Database (must be the SAME database the backend uses) ----
DATABASE_URL=postgresql://insightx_user:insightx_pass@localhost:5432/insightx_db

# ---- Redis / Celery broker ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- Shared upload directory ----
# The worker reads the files the backend saved. This MUST point at the
# backend's uploads folder.
#   * Docker:    /app/uploads   (the path the backend's uploads dir is mounted to)
#   * Local run: absolute path to backend/uploads, e.g.
#                UPLOAD_DIR=D:/projects/InsightX/InsightX-Core/backend/uploads
UPLOAD_DIR=/app/uploads

# ---- Gemini LLM enrichment (optional, Phase 4) ----
# Free key: https://aistudio.google.com/apikey  (1,500 req/day).
# Leave blank to disable LLM insight enrichment.
GOOGLE_AI_API_KEY=
