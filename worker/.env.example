# Environment — copy to .env and fill in values

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Database
DATABASE_URL=postgresql://insightx_user:insightx_pass@localhost:5432/insightx_db
MONGO_URL=mongodb://localhost:27017/insightx_scraped

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
DD_API_KEY=your-datadog-api-key
DD_ENV=development

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=insightx-raw-data-lake-dev

# Local LLM Support (Ollama)
LOCAL_LLM_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen2.5-coder:7b

# Groq
GROQ_API_KEY=
